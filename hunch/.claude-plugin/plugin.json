    "mcp",
    "hunch",
    "classification",
    "tagging",
    "scoring",
    "sentiment",
    "lead-scoring",
    "spreadsheets",
    "csv"
  ],
  "mcpServers": "./.mcp.json",
  "defaultEnabled": true,
  "repository": "https://github.com/Eddy1919/hunch-mcp"
}
